# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.1.2.216
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8000,http://10.1.2.216

# Database: sqlite (development) or postgres (production)
DATABASE_ENGINE=sqlite
# DATABASE_ENGINE=postgres
POSTGRES_DB=bahria_policy_bot
POSTGRES_USER=bahria
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Groq (chat + embeddings). Never commit a real key.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=qwen/qwen3.8-27b
GROQ_TIMEOUT=120
GROQ_TEMPERATURE=0.4
GROQ_MAX_TOKENS=800
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# Embeddings. Providers: groq | sentence-transformers | lexical
# groq:          nomic-embed-text-v1.5 (only if your Groq account lists it)
# sentence-transformers: uses all-MiniLM-L6-v2 from a local cache/path; no Hugging Face needed if files exist
# lexical:       hashed bag-of-words vectors (also the automatic offline fallback)
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Optional absolute path to a downloaded MiniLM folder (modules.json inside).
# EMBEDDING_MODEL_PATH=
# Set false on servers that cannot reach huggingface.co (avoids a long failed download).
# EMBEDDING_ALLOW_DOWNLOAD=true
# Hugging Face cache. Searched locally first; download is only attempted if missing and allowed.
# HF_HOME=/srv/data/huggingface
# HF_HUB_OFFLINE=1
# HF_HUB_DISABLE_XET=1

# Vector database (local ChromaDB)
VECTOR_DB_PATH=./data/chroma
VECTOR_COLLECTION=bahria_policies

# RAG retrieval
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RAG_TOP_K=4
SIMILARITY_THRESHOLD=0.28
MAX_CONTEXT_CHARS=3800
GRAPH_RAG_ENABLED=true
GRAPH_MIN_VECTOR_HITS=2
GRAPH_STRONG_SCORE=0.45
GRAPH_EXPAND_LIMIT=6

# Uploads
MAX_UPLOAD_MB=20
MEDIA_ROOT=./data/documents

# Processing
PROCESS_DOCUMENTS_ASYNC=true

# Website scraper
SCRAPE_MAX_PAGES=80
SCRAPE_MAX_DEPTH=5
SCRAPE_TIMEOUT=20
SCRAPE_MAX_DOCUMENTS=40
SCRAPE_MAX_IMAGES=25
SCRAPE_MAX_FILE_MB=12
SCRAPE_DELAY=0.12

# CORS (Vite + Expo app)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8081,http://127.0.0.1:8081,http://10.1.2.216

# Frontend (Vite)
VITE_API_BASE=
