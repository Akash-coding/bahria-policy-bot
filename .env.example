# Django
DJANGO_SECRET_KEY=change-this-to-a-long-random-string
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000

# Database: sqlite (development) or postgres (production)
DATABASE_ENGINE=sqlite
# DATABASE_ENGINE=postgres
POSTGRES_DB=bahria_policy_bot
POSTGRES_USER=bahria
POSTGRES_PASSWORD=change-this-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Ollama (local LLM — do not point this at a cloud AI API)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
OLLAMA_TIMEOUT=600
OLLAMA_TEMPERATURE=0.3
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=400

# Embeddings (local). Providers: ollama | sentence-transformers | lexical
# ollama:        pull with `ollama pull nomic-embed-text`
# sentence-transformers: downloads all-MiniLM-L6-v2 locally on first run
# lexical:       bag-of-words vectors for tests only
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Vector database (local ChromaDB)
VECTOR_DB_PATH=./data/chroma
VECTOR_COLLECTION=bahria_policies

# RAG retrieval
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RAG_TOP_K=4
SIMILARITY_THRESHOLD=0.28
MAX_CONTEXT_CHARS=3800
GRAPH_RAG_ENABLED=true
GRAPH_MIN_VECTOR_HITS=2
GRAPH_STRONG_SCORE=0.45
GRAPH_EXPAND_LIMIT=6

# Uploads
MAX_UPLOAD_MB=20
MEDIA_ROOT=./data/documents

# Processing
PROCESS_DOCUMENTS_ASYNC=true

# CORS (Vite dev server)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Frontend (Vite)
VITE_API_BASE=
